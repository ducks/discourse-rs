{
  "user": "admin",
  "s3": {
    "buckets": ["s3-direct-uploads-b", "s3-direct-backups-b"],
    "objects": {
      "s3-direct-backups-b/default/taken.tar.gz": "backup.tar.gz"
    }
  },
  "settings": {
    "s3_upload_bucket": "s3-direct-uploads-b",
    "s3_backup_bucket": "s3-direct-backups-b",
    "s3_access_key_id": "discourse-rs-test",
    "s3_secret_access_key": "discourse-rs-test-secret",
    "s3_region": "us-east-1",
    "s3_endpoint": "http://minio.localhost:9122",
    "enable_s3_uploads": true,
    "enable_direct_s3_uploads": true,
    "backup_location": "s3"
  },
  "ignore": ["/responses/0/body/external_upload_identifier", "/responses/5/body/external_upload_identifier", "/changes/external_upload_stubs/inserted/*/external_upload_identifier"],
  "requests": [
    {
      "method": "POST",
      "path": "/admin/backups/create-multipart.json",
      "params": {"file_name": "fresh.tar.gz", "file_size": 10485760, "upload_type": "backup"}
    },
    {
      "method": "POST",
      "path": "/admin/backups/create-multipart.json",
      "params": {"file_name": "taken.tar.gz", "file_size": 10485760, "upload_type": "backup"}
    },
    {
      "method": "POST",
      "path": "/admin/backups/create-multipart.json",
      "params": {"file_name": "x.zip", "file_size": 10485760, "upload_type": "backup"}
    },
    {
      "method": "POST",
      "path": "/admin/backups/batch-presign-multipart-parts.json",
      "params": {"part_numbers": ["1"], "unique_identifier": "{{responses.0.body.unique_identifier}}"}
    },
    {
      "method": "POST",
      "path": "/admin/backups/abort-multipart.json",
      "params": {"external_upload_identifier": "{{responses.0.body.external_upload_identifier}}"}
    },
    {
      "method": "POST",
      "path": "/uploads/create-multipart.json",
      "params": {"file_name": "sneaky.tar.gz", "file_size": 100, "upload_type": "backup"}
    }
  ]
}
