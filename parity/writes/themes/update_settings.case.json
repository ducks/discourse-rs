{
  "user": "admin",
  "requests": [
    {
      "method": "POST",
      "path": "/admin/themes.json",
      "params": {
        "theme": {
          "name": "Configurable",
          "theme_fields": [
            {
              "name": "yaml",
              "target": "settings",
              "value": "show_banner: true\nbanner_text:\n  default: Welcome\nsize:\n  type: enum\n  default: small\n  choices:\n    - small\n    - large\ncount: 3\n"
            },
            {
              "name": "en",
              "target": "translations",
              "value": "en:\n  greeting: Hello\n  farewell: Bye\n"
            },
            {
              "name": "header",
              "target": "common",
              "value": "<div>banner</div>"
            }
          ]
        }
      }
    },
    {
      "method": "PUT",
      "path": "/admin/themes/{{responses.0.body.theme.id}}.json",
      "params": {
        "theme": {
          "settings": {
            "show_banner": "false",
            "size": "large"
          }
        }
      }
    },
    {
      "method": "PUT",
      "path": "/admin/themes/{{responses.0.body.theme.id}}/setting.json",
      "params": {
        "name": "banner_text",
        "value": "Hi there"
      }
    },
    {
      "method": "PUT",
      "path": "/admin/themes/{{responses.0.body.theme.id}}/setting.json",
      "params": {
        "name": "count",
        "value": "7"
      }
    },
    {
      "method": "PUT",
      "path": "/admin/themes/{{responses.0.body.theme.id}}/setting.json",
      "params": {
        "name": "size",
        "value": "huge"
      }
    },
    {
      "method": "PUT",
      "path": "/admin/themes/{{responses.0.body.theme.id}}/setting.json",
      "params": {
        "name": "show_banner"
      }
    },
    {
      "method": "PUT",
      "path": "/admin/themes/{{responses.0.body.theme.id}}.json",
      "params": {
        "theme": {
          "settings": {
            "nope": "1"
          }
        }
      }
    },
    {
      "method": "PUT",
      "path": "/admin/themes/{{responses.0.body.theme.id}}.json",
      "params": {
        "theme": {
          "translations": {
            "greeting": "Howdy"
          }
        }
      }
    },
    {
      "method": "PUT",
      "path": "/admin/themes/{{responses.0.body.theme.id}}.json",
      "params": {
        "theme": {
          "translations": {
            "farewell": "Later",
            "greeting": "Hello"
          }
        }
      }
    },
    {
      "method": "PUT",
      "path": "/admin/themes/{{responses.0.body.theme.id}}.json",
      "params": {
        "theme": {
          "settings": {
            "size": "huge"
          }
        }
      }
    },
    {
      "method": "GET",
      "path": "/admin/themes/{{responses.0.body.theme.id}}.json"
    }
  ],
  "unordered_responses": [
    "/responses/0/body/theme/theme_fields",
    "/responses/1/body/theme/theme_fields",
    "/responses/7/body/theme/theme_fields",
    "/responses/8/body/theme/theme_fields",
    "/responses/10/body/theme/theme_fields"
  ]
}
