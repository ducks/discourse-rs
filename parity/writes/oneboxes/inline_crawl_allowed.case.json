{
  "user": "user1",
  "settings": {
    "enable_inline_onebox_on_all_domains": false,
    "allowed_inline_onebox_domains": "example.com|fixtures.localhost",
    "block_onebox_on_redirect": true,
    "allowed_internal_hosts": "fixtures.localhost",
    "s3_endpoint": "http://fixtures.localhost:8099"
  },
  "remote": {
    "/titled": {
      "status": 200,
      "headers": {
        "Content-Type": "text/html; charset=utf-8"
      },
      "body": "<title>Allowed page</title>"
    },
    "/moved": {
      "status": 302,
      "headers": {
        "Location": "http://fixtures.localhost:8099/titled"
      },
      "body": ""
    }
  },
  "requests": [
    {
      "method": "GET",
      "path": "/inline-onebox",
      "params": {
        "urls": [
          "http://fixtures.localhost:8099/titled",
          "http://fixtures.localhost:8099/moved",
          "http://other.localhost:8099/titled"
        ]
      }
    }
  ]
}
