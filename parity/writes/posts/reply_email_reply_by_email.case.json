{
  "user": "user1",
  "settings": {
    "reply_by_email_address": "replies+%{reply_key}@example.com",
    "manual_polling_enabled": true,
    "reply_by_email_enabled": true
  },
  "requests": [
    {
      "method": "POST",
      "path": "/posts.json",
      "params": {
        "topic_id": 35,
        "raw": "A reply from user1 that the watchers can answer by email, with reply keys on."
      }
    }
  ],
  "run_jobs": [
    "post_alert",
    "user_email"
  ]
}
