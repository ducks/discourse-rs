      "html": "<!DOCTYPE html><html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\" xml:lang=\"en\"><head>\n    <meta http-equiv=\"Content-type\" name=\"viewport\" content=\"initial-scale=1.0, maximum-scale=1.0, user-scalable=no, width=device-width\">\n    \n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"supported-color-schemes\" content=\"light dark\">\n    \n    <!-- prevent ios zooming + autoscaling -->\n    <meta name=\"x-apple-disable-message-reformatting\">\n    <title></title>\n  </head>\n\n  <body style=\"line-height:1.4;text-align:left\" dir=\"ltr\">\n    <!--[if mso]>\n      <style type=\"text/css\">\n        body,\n        table,\n        td,\n        th,\n        h1,\n        h2,\n        h3 {\n          font-family: Arial, sans-serif !important;\n        }\n      </style>\n    <![endif]-->\n\n    <div style=\"display:none\"></div>\n\n    \n    <div class=\"summary-email\" style=\"-moz-box-sizing:border-box;-ms-text-size-adjust:100%;-webkit-box-sizing:border-box;-webkit-text-size-adjust:100%;box-sizing:border-box;color:#0a0a0a;font-family:Arial,sans-serif;font-size:14px;font-weight:400;line-height:1.3;margin:0;min-width:100%;padding:0;width:100%\">\n  <table class=\"chat-summary-header text-header with-dir\" style=\"text-align:left;background-color:#fff;width:100%;min-width:100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" dir=\"ltr\" dm=\"header\">\n    <tbody><tr>\n      <td align=\"center\" style=\"text-align:center;padding:20px 0;font-family:Arial,sans-serif\">\n        <a href=\"http://localhost:3042\" style=\"text-decoration:none;font-weight:bold;color:#333;font-size:22px\">\n            <img src=\"http://localhost:3042/images/discourse-logo-sketch.png\" height=\"40\" style=\"clear:both;display:block;height:40px;margin:auto;max-width:100%;outline:0;text-decoration:none\" alt=\"Discourse\">\n        </a>\n      </td>\n    </tr>\n    <tr>\n      <td align=\"center\" style=\"font-weight:bold;font-size:22px;color:#333\">\n        You have a new chat message\n      </td>\n    </tr>\n  </tbody></table>\n\n      <table class=\"chat-summary-content\" style=\"padding:1em;margin-top:20px;width:100%;min-width:100%;background-color:#f7f7f7\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" dm=\"body\">\n        <tbody>\n          <tr>\n            <td colspan=\"100%\">\n              <h5 style=\"margin:0.5em 0 0.5em 0;font-size:0.9em\">\n                  Weekend plans\n              </h5>\n            </td>\n          </tr>\n\n              <tr class=\"message-row\">\n                <td style=\"white-space:nowrap;vertical-align:top;padding:1em 0 0 2em\">\n                  <img src=\"http://localhost:3042/letter_avatar_proxy/v4/letter/u/ecb155/45.png\" style=\"height:20px;width:20px;margin:0 5px 0 0;border-radius:50%;clear:both;display:inline-block;outline:0;text-decoration:none;vertical-align:top\" alt=\"user2\">\n                  <span style=\"display:inline-block;color:#0a0a0a;vertical-align:top;font-weight:bold\">\n                    user2                  </span>\n                  <span style=\"display:inline-block;color:#0a0a0a;font-size:0.8em\">\n                    November 23, 2026,  4:01pm                  </span>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"width:99%;margin:0;padding:0 0 0 2em;vertical-align:top\">\n                  <p>hike on saturday</p>\n                </td>\n              </tr>\n\n          <tr>\n            <td colspan=\"100%\" style=\"padding:2em 0 0 2em\">\n              <a class=\"more-messages-link\" href=\"http://localhost:3042/chat/c/-/13/41\" style=\"text-decoration:none;font-weight:bold;color:#006699\">\n                  View message\n              </a>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n</div>\n\n<table class=\"summary-footer with-dir\" style=\"text-align:left;margin-top:2em;width:100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" dir=\"ltr\" dm=\"text-color\">\n  <tbody><tr>\n    <td align=\"center\">\n         This chat summary is sent from <a href=\"http://localhost:3042\" style=\"text-decoration:none;font-weight:bold;color:#006699\">Discourse</a> when you are away. Change your <a href=\"http://localhost:3042/my/preferences/emails\" style=\"text-decoration:none;font-weight:bold;color:#006699\">chat email preference</a>.\n    </td>\n  </tr>\n</tbody></table>\n\n    \n\n\n    <!-- prevent Gmail on iOS font size manipulation -->\n    <div style=\"display:none;white-space:nowrap;font:15px courier;line-height:0\">\n      &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\n      &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\n      &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\n    </div>\n    \n    <style>\n      @media (prefers-color-scheme: dark) {\n        html {\n          background: #151515 !important;\n        }\n\n        h1,\n        h2,\n        h3,\n        h4,\n        h5,\n        h6,\n        p,\n        span,\n        td {\n          color: inherit !important;\n        }\n\n        [data-stripped-secure-media] {\n          border-color: #454545 !important;\n        }\n\n        [data-stripped-secure-upload] {\n          border-color: #454545 !important;\n        }\n\n        [dm='text-color'] {\n          color: #dddddd;\n        }\n\n        [dm='header'] {\n          background: #151515 !important;\n        }\n\n        [dm='topic-body'] {\n          background: #151515 !important;\n          border-bottom: 1px solid #454545 !important;\n        }\n\n        [dm='triangle'] {\n          border-top-color: #151515 !important;\n        }\n\n        [dm='body'] {\n          background: #222222 !important;\n          color: #dddddd !important;\n        }\n\n        [dm='body_primary'] {\n          background: #062e3d !important;\n          color: #dddddd !important;\n        }\n\n        code,\n        pre code,\n        blockquote {\n          background: #323232 !important;\n          border-color: #454545 !important;\n          color: #dddddd !important;\n        }\n      }\n    </style>\n    \n  \n\n</body></html>"
