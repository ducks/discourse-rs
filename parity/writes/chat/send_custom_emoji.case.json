{
  "user": "user1",
  "settings": {
    "emoji_deny_list": "heart"
  },
  "setup": [
    "INSERT INTO custom_emojis (name, upload_id, created_at, updated_at, \"group\", user_id) VALUES ('party_parrot', 34, now(), now(), 'party', 1)"
  ],
  "requests": [
    {
      "method": "POST",
      "path": "/chat/2.json",
      "params": {
        "message": "party :party_parrot: time :heart: :smile:",
        "staged_id": "staged-1"
      }
    },
    {
      "method": "PUT",
      "path": "/chat/2/react/{{responses.0.body.message_id}}.json",
      "params": {
        "emoji": "party_parrot",
        "react_action": "add"
      }
    }
  ],
  "run_jobs": [
    "Jobs::Chat::ProcessMessage"
  ]
}
