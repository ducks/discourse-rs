{
  "user": null,
  "settings": {
    "allowed_internal_hosts": "fixtures.localhost",
    "auth_require_interaction": false,
    "discourse_id_client_id": "did-client",
    "discourse_id_client_secret": "did-secret",
    "discourse_id_provider_url": "http://fixtures.localhost:8099/did",
    "enable_discourse_id": true
  },
  "remote": {
    "/did/oauth/token": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"access_token\":\"did-token\",\"token_type\":\"Bearer\",\"scope\":\"read\",\"info\":{\"uuid\":\"did-uuid-1\",\"username\":\"idperson\",\"name\":\"Id Person\",\"email\":\"id.person@example.com\",\"image\":null,\"createdAt\":\"2026-01-01\"}}"
    }
  },
  "keep_headers": ["Location"],
  "requests": [
    {
      "method": "GET",
      "path": "/auth/discourse_id?signup=true&email=id.person%40example.com"
    },
    {
      "method": "GET",
      "path": "/auth/discourse_id/callback?code=good-code&state={{responses.0.headers.Location|state_param}}"
    },
    {"method": "GET", "path": "/session/hp.json"},
    {
      "method": "POST",
      "path": "/u.json",
      "params": {
        "email": "id.person@example.com",
        "username": "idperson",
        "name": "Id Person",
        "password_confirmation": "{{responses.2.body.value}}",
        "challenge": "{{responses.2.body.challenge|reverse}}"
      }
    }
  ],
  "ignore": [
    "/responses/0/headers/Location",
    "/responses/0/body"
  ]
}
