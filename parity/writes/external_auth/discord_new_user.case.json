{
  "user": null,
  "settings": {
    "auth_require_interaction": false,
    "discord_client_id": "discord-client",
    "discord_secret": "discord-secret",
    "discord_trusted_guilds": "111|222",
    "enable_discord_logins": true
  },
  "remote_hosts": {
    "https://discord.com/api": "/discord"
  },
  "remote": {
    "/discord/oauth2/token": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"access_token\":\"discord-token\",\"token_type\":\"Bearer\",\"scope\":\"identify email guilds\"}"
    },
    "/discord/users/@me": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"id\":\"80351110224678913\",\"username\":\"kelly\",\"global_name\":\"Kelly K\",\"avatar\":null,\"verified\":false,\"email\":\"kelly@example.com\",\"accentColor\":3}"
    },
    "/discord/users/@me/guilds": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "[{\"id\":\"222\",\"name\":\"Trusted\",\"approximateMemberCount\":5}]"
    }
  },
  "keep_headers": ["Location"],
  "requests": [
    {
      "method": "GET",
      "path": "/auth/discord"
    },
    {
      "method": "GET",
      "path": "/auth/discord/callback?code=good-code&state={{responses.0.headers.Location|state_param}}"
    },
    {
      "method": "GET",
      "path": "/session/current.json"
    }
  ],
  "ignore": [
    "/responses/0/headers/Location",
    "/responses/0/body"
  ]
}
