{
  "user": "user2",
  "settings": {
    "allowed_internal_hosts": "fixtures.localhost",
    "auth_require_interaction": false,
    "oauth2_client_id": "basic-client",
    "oauth2_client_secret": "basic-secret",
    "oauth2_authorize_url": "http://fixtures.localhost:8099/authorize",
    "oauth2_token_url": "http://fixtures.localhost:8099/token",
    "oauth2_user_json_url": "http://fixtures.localhost:8099/user.json",
    "oauth2_json_user_id_path": "id",
    "oauth2_json_username_path": "login",
    "oauth2_json_email_path": "email",
    "oauth2_allow_association_change": true,
    "oauth2_enabled": true
  },
  "setup": [
    "INSERT INTO user_associated_accounts (id, provider_name, provider_uid, user_id, last_used, info, credentials, extra, created_at, updated_at) VALUES (9501, 'oauth2_basic', 'old-uid', 4, now() - interval '1 day', '{\"nickname\":\"olduser2\"}', '{}', '{}', now() - interval '1 day', now() - interval '1 day'), (9502, 'facebook', 'fb-9502', 4, now() - interval '1 day', '{}', '{}', '{}', now() - interval '1 day', now() - interval '1 day')"
  ],
  "remote": {
    "/token": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"access_token\":\"access-9\"}"
    },
    "/user.json": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"id\":77,\"login\":\"remoteuser2\",\"email\":\"someone.else@example.com\"}"
    }
  },
  "keep_headers": ["Location"],
  "requests": [
    {
      "method": "GET",
      "path": "/u/user2/emails.json"
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic?reconnect=true"
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic/callback?code=good-code&state={{responses.1.headers.Location|state_param}}"
    },
    {
      "method": "GET",
      "path": "/associate/{{responses.2.headers.Location|last_segment}}.json"
    },
    {
      "method": "POST",
      "path": "/associate/{{responses.2.headers.Location|last_segment}}.json"
    },
    {
      "method": "GET",
      "path": "/u/user2/emails.json"
    },
    {
      "method": "POST",
      "path": "/u/user2/preferences/revoke-account.json",
      "params": {"provider_name": "facebook"}
    },
    {
      "method": "POST",
      "path": "/u/user2/preferences/revoke-account.json",
      "params": {"provider_name": "github"}
    },
    {
      "method": "POST",
      "path": "/u/user2/preferences/revoke-account.json",
      "params": {"provider_name": "nonsense"}
    },
    {
      "method": "POST",
      "path": "/u/user1/preferences/revoke-account.json",
      "params": {"provider_name": "oauth2_basic"}
    },
    {
      "method": "GET",
      "path": "/u/user2/emails.json"
    }
  ],
  "ignore": [
    "/responses/1/headers/Location",
    "/responses/1/body",
    "/responses/2/headers/Location",
    "/responses/3/body/token"
  ]
}
