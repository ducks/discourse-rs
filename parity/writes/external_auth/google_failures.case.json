{
  "user": null,
  "settings": {
    "allowed_internal_hosts": "fixtures.localhost",
    "auth_require_interaction": false,
    "google_oauth2_client_id": "gclient",
    "google_oauth2_client_secret": "gsecret",
    "google_oauth2_hd": "example.com",
    "enable_google_oauth2_logins": true
  },
  "remote_hosts": {
    "https://oauth2.googleapis.com": "/g-oauth",
    "https://www.googleapis.com": "/g-apis"
  },
  "remote": {
    "/g-oauth/token": {
      "status": 200,
      "headers": {"Content-Type": "application/json; charset=utf-8"},
      "body": "{\"access_token\":\"g-token-2\",\"token_type\":\"Bearer\"}"
    },
    "/g-apis/oauth2/v3/userinfo": {
      "status": 200,
      "headers": {"Content-Type": "application/json; charset=utf-8"},
      "body": "{\"sub\":\"g-2\",\"email\":\"someone@other.example\",\"email_verified\":true,\"hd\":\"other.example\"}"
    }
  },
  "keep_headers": ["Location"],
  "requests": [
    {
      "method": "GET",
      "path": "/auth/google_oauth2"
    },
    {
      "method": "GET",
      "path": "/auth/google_oauth2/callback?code=good-code&state={{responses.0.headers.Location|state_param}}"
    },
    {
      "method": "GET",
      "path": "/auth/google_oauth2?state=chosen-state&redirect_uri=https%3A%2F%2Fapp.example%2Fcb&login_hint=a%20b%40example.com&openid_realm=realm"
    },
    {
      "method": "GET",
      "path": "/auth/google_oauth2/callback?state=chosen-state"
    },
    {
      "method": "GET",
      "path": "/auth/google_oauth2"
    },
    {
      "method": "GET",
      "path": "/auth/google_oauth2/callback?error=access_denied&state={{responses.4.headers.Location|state_param}}"
    }
  ],
  "ignore": [
    "/responses/0/headers/Location",
    "/responses/0/body",
    "/responses/4/headers/Location",
    "/responses/4/body"
  ]
}
