{
  "user": null,
  "settings": {
    "allowed_internal_hosts": "fixtures.localhost",
    "auth_require_interaction": false,
    "enable_local_logins": false,
    "oauth2_client_id": "basic-client",
    "oauth2_client_secret": "basic-secret",
    "oauth2_authorize_url": "http://fixtures.localhost:8099/authorize",
    "oauth2_token_url": "http://fixtures.localhost:8099/token",
    "oauth2_user_json_url": "http://fixtures.localhost:8099/user.json",
    "oauth2_json_user_id_path": "id",
    "oauth2_json_username_path": "login",
    "oauth2_json_email_path": "mail",
    "oauth2_json_email_verified_path": "verified",
    "oauth2_enabled": true
  },
  "remote": {
    "/token": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"access_token\":\"access-7\"}"
    },
    "/user.json": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"id\":707,\"login\":\"unverified\",\"mail\":\"unverified.person@example.com\",\"verified\":false}"
    }
  },
  "keep_headers": ["Location"],
  "requests": [
    {"method": "GET", "path": "/session/hp.json"},
    {
      "method": "POST",
      "path": "/u.json",
      "params": {
        "email": "nobody@example.com",
        "username": "nobody",
        "password": "a-long-enough-pass-phrase",
        "password_confirmation": "{{responses.0.body.value}}",
        "challenge": "{{responses.0.body.challenge|reverse}}"
      }
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic"
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic/callback?code=good-code&state={{responses.2.headers.Location|state_param}}"
    },
    {"method": "GET", "path": "/session/hp.json"},
    {
      "method": "POST",
      "path": "/u.json",
      "params": {
        "email": "different.address@example.com",
        "username": "unverified",
        "password_confirmation": "{{responses.4.body.value}}",
        "challenge": "{{responses.4.body.challenge|reverse}}"
      }
    }
  ],
  "run_jobs": [
    "critical_user_email"
  ],
  "ignore": [
    "/responses/2/headers/Location",
    "/responses/2/body"
  ]
}
