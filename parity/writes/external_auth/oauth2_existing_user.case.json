{
  "user": null,
  "settings": {
    "allowed_internal_hosts": "fixtures.localhost",
    "auth_require_interaction": false,
    "oauth2_client_id": "basic-client",
    "oauth2_client_secret": "basic-secret",
    "oauth2_authorize_url": "http://fixtures.localhost:8099/authorize",
    "oauth2_token_url": "http://fixtures.localhost:8099/token",
    "oauth2_user_json_url": "http://fixtures.localhost:8099/user.json",
    "oauth2_json_user_id_path": "user.id",
    "oauth2_json_username_path": "user.login",
    "oauth2_json_name_path": "user.name",
    "oauth2_json_email_path": "user.mail",
    "oauth2_json_email_verified_path": "verified",
    "oauth2_json_avatar_path": "user.avatar",
    "oauth2_scope": "read",
    "oauth2_enabled": true
  },
  "remote": {
    "/token": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"access_token\":\"access-1\",\"token_type\":\"Bearer\",\"expires_in\":3600,\"refresh_token\":\"refresh-1\"}"
    },
    "/user.json": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"user\":{\"id\":4242,\"login\":\"user1\",\"name\":\"User One\",\"mail\":\"user1@example.com\",\"avatar\":\"http://fixtures.localhost:8099/avatar.png\"},\"verified\":true}"
    }
  },
  "keep_headers": ["Location"],
  "requests": [
    {
      "method": "GET",
      "path": "/auth/oauth2_basic"
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic/callback?code=good-code&state={{responses.0.headers.Location|state_param}}"
    },
    {
      "method": "GET",
      "path": "/session/current.json"
    }
  ],
  "ignore": [
    "/responses/0/headers/Location",
    "/responses/0/body",
    "/changes/user_associated_accounts/inserted/*/credentials/expires_at"
  ]
}
