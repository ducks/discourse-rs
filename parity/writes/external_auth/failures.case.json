{
  "user": null,
  "settings": {
    "allowed_internal_hosts": "fixtures.localhost",
    "auth_require_interaction": false,
    "oauth2_client_id": "basic-client",
    "oauth2_client_secret": "basic-secret",
    "oauth2_authorize_url": "http://fixtures.localhost:8099/authorize",
    "oauth2_token_url": "http://fixtures.localhost:8099/token",
    "oauth2_user_json_url": "http://fixtures.localhost:8099/missing.json",
    "oauth2_enabled": true
  },
  "remote": {
    "/token": {
      "status": 200,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"access_token\":\"access-3\"}"
    }
  },
  "keep_headers": ["Location"],
  "fragment": ["<div id=\"simple-container\">", "</div>\n</div>"],
  "requests": [
    {
      "method": "GET",
      "path": "/auth/oauth2_basic?origin=%2Flatest"
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic/callback?code=good-code&state=not-the-state"
    },
    {
      "method": "GET",
      "path": "/auth/failure?message=csrf_detected&strategy=oauth2_basic",
      "headers": {"Accept": "text/html", "X-Requested-With": ""}
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic"
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic/callback?error=access_denied&error_description=No+thanks&state={{responses.3.headers.Location|state_param}}"
    },
    {
      "method": "GET",
      "path": "/auth/failure?message=access_denied&strategy=oauth2_basic",
      "headers": {"Accept": "text/html", "X-Requested-With": ""}
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic"
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic/callback?code=good-code&state={{responses.6.headers.Location|state_param}}",
      "headers": {"Accept": "text/html", "X-Requested-With": ""}
    },
    {
      "method": "GET",
      "path": "/auth/failure?message=whatever%3Cscript%3E",
      "headers": {"Accept": "text/html", "X-Requested-With": ""}
    },
    {
      "method": "POST",
      "path": "/auth/oidc"
    }
  ],
  "ignore": [
    "/responses/0/headers/Location",
    "/responses/0/body",
    "/responses/3/headers/Location",
    "/responses/3/body",
    "/responses/6/headers/Location",
    "/responses/6/body"
  ]
}
