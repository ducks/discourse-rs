{
  "user": null,
  "settings": {
    "allowed_internal_hosts": "fixtures.localhost",
    "auth_require_interaction": false,
    "oauth2_client_id": "basic-client",
    "oauth2_client_secret": "basic-secret",
    "oauth2_authorize_url": "http://fixtures.localhost:8099/authorize",
    "oauth2_token_url": "http://fixtures.localhost:8099/token",
    "oauth2_user_json_url": "http://fixtures.localhost:8099/user.json",
    "oauth2_json_user_id_path": "id",
    "oauth2_json_username_path": "login",
    "oauth2_json_name_path": "name",
    "oauth2_json_email_path": "mail",
    "oauth2_email_verified": true,
    "oauth2_enabled": true,
    "auth_overrides_username": true,
    "auth_overrides_name": true
  },
  "remote": {
    "/token": {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"access_token\":\"access-6\"}"
    },
    "/user.json": {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"id\":808,\"login\":\"Overrider\",\"name\":\"Provider Name\",\"mail\":\"overrider@example.com\"}"
    }
  },
  "keep_headers": [
    "Location"
  ],
  "requests": [
    {
      "method": "GET",
      "path": "/auth/oauth2_basic"
    },
    {
      "method": "GET",
      "path": "/auth/oauth2_basic/callback?code=good-code&state={{responses.0.headers.Location|state_param}}"
    },
    {
      "method": "GET",
      "path": "/session/hp.json"
    },
    {
      "method": "POST",
      "path": "/u.json",
      "params": {
        "name": "Typed Name",
        "email": "overrider@example.com",
        "username": "Overrider",
        "password_confirmation": "{{responses.2.body.value}}",
        "challenge": "{{responses.2.body.challenge|reverse}}",
        "timezone": "Europe/Paris"
      }
    },
    {
      "method": "GET",
      "path": "/session/current.json"
    }
  ],
  "ignore": [
    "/responses/0/headers/Location",
    "/responses/0/body"
  ]
}
