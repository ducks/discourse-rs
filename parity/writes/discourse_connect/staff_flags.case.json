{
  "user": null,
  "settings": {
    "discourse_connect_url": "https://idp.example.com/sso",
    "discourse_connect_secret": "parity-connect-secret",
    "enable_discourse_connect": true
  },
  "setup": [
    "INSERT INTO single_sign_on_records (id, user_id, external_id, last_payload, created_at, updated_at, external_username, external_email, external_name) VALUES (9511, 4, 'ext-user2-staff', 'old', now() - interval '2 days', now() - interval '2 days', 'user2', 'user2@example.com', 'User Two')"
  ],
  "keep_headers": ["Location"],
  "requests": [
    {
      "method": "GET",
      "path": "/session/sso"
    },
    {
      "method": "GET",
      "path": "/session/sso_login",
      "discourse_connect": {
        "secret": "parity-connect-secret",
        "fields": {
          "nonce": "{{responses.0.headers.Location|sso_nonce}}",
          "external_id": "ext-user2-staff",
          "email": "user2@example.com",
          "admin": "false",
          "moderator": "true",
          "title": "Connected moderator"
        }
      }
    }
  ],
  "ignore": [
    "/responses/0/headers/Location",
    "/changes/single_sign_on_records/updated/*/after/last_payload"
  ]
}
