{
  "user": "user1",
  "settings": {
    "enable_discourse_connect_provider": true,
    "discourse_connect_provider_secrets": "provider.example.com|prov-secret"
  },
  "keep_headers": ["Location"],
  "requests": [
    {
      "method": "GET",
      "path": "/session/sso_provider",
      "headers": {"Accept": "text/html", "X-Requested-With": ""},
      "discourse_connect": {
        "secret": "prov-secret",
        "fields": {
          "nonce": "provider-nonce-2fa",
          "return_sso_url": "https://provider.example.com/sso_return",
          "require_2fa": "true"
        }
      }
    }
  ]
}
