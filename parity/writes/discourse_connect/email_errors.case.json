{
  "user": null,
  "settings": {
    "discourse_connect_url": "https://idp.example.com/sso",
    "discourse_connect_secret": "parity-connect-secret",
    "enable_discourse_connect": true,
    "blocked_email_domains": "blocked.example.com"
  },
  "keep_headers": ["Location"],
  "fragment": ["<h1>", "</p>"],
  "requests": [
    {
      "method": "GET",
      "path": "/session/sso"
    },
    {
      "method": "GET",
      "path": "/session/sso_login",
      "headers": {"Accept": "text/html", "X-Requested-With": ""},
      "discourse_connect": {
        "secret": "parity-connect-secret",
        "fields": {
          "nonce": "{{responses.0.headers.Location|sso_nonce}}",
          "external_id": "ext-blank-email",
          "username": "nomail"
        }
      }
    },
    {
      "method": "GET",
      "path": "/session/sso"
    },
    {
      "method": "GET",
      "path": "/session/sso_login",
      "headers": {"Accept": "text/html", "X-Requested-With": ""},
      "discourse_connect": {
        "secret": "parity-connect-secret",
        "fields": {
          "nonce": "{{responses.2.headers.Location|sso_nonce}}",
          "external_id": "ext-blocked",
          "email": "someone@blocked.example.com"
        }
      }
    }
  ],
  "ignore": [
    "/responses/0/headers/Location",
    "/responses/2/headers/Location"
  ]
}
