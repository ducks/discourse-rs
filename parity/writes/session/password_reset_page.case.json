{
  "requests": [
    {
      "method": "POST",
      "path": "/session/forgot_password.json",
      "params": {
        "login": "user1@example.com"
      }
    },
    {
      "method": "POST",
      "path": "/session/password-reset-code/verify.json",
      "params": {
        "code": "{{jobs.send_email_login_code.code}}"
      }
    },
    {
      "method": "GET",
      "path": "/u/password-reset/{{responses.1.body.redirect_url|last_segment}}.json"
    },
    {
      "method": "GET",
      "path": "/u/confirm-email-token/{{responses.1.body.redirect_url|last_segment}}.json"
    },
    {
      "method": "GET",
      "path": "/u/password-reset/{{responses.1.body.redirect_url|last_segment}}.json"
    },
    {
      "method": "PUT",
      "path": "/u/password-reset/{{responses.1.body.redirect_url|last_segment}}.json",
      "params": {
        "password": "a-brand-new-pass-phrase"
      }
    },
    {
      "method": "GET",
      "path": "/u/password-reset/{{responses.1.body.redirect_url|last_segment}}.json"
    }
  ]
}
