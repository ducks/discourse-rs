{
  "requests": [
    {
      "method": "GET",
      "path": "/session/hp.json"
    },
    {
      "method": "POST",
      "path": "/u.json",
      "params": {
        "name": "New Person",
        "email": "new.person@example.com",
        "password": "a-long-enough-pass-phrase",
        "username": "newperson",
        "password_confirmation": "{{responses.0.body.value}}",
        "challenge": "{{responses.0.body.challenge|reverse}}"
      }
    },
    {
      "method": "GET",
      "path": "/session/hp.json"
    },
    {
      "method": "PUT",
      "path": "/u/activate-account/{{jobs.critical_user_email.email_token}}.json",
      "params": {
        "password_confirmation": "{{responses.2.body.value}}",
        "challenge": "{{responses.2.body.challenge|reverse}}"
      }
    }
  ]
}
