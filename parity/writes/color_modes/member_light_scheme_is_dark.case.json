{
  "user": "user1",
  "setup": [
    "UPDATE color_schemes SET user_selectable = true WHERE id = 18",
    "UPDATE user_options SET color_scheme_id = 18 WHERE user_id = 3"
  ],
  "cookies": {
    "forced_color_mode": "light"
  },
  "requests": [
    {
      "method": "GET",
      "path": "/latest",
      "headers": {
        "Accept": "text/html",
        "X-Requested-With": ""
      }
    }
  ],
  "extract": [
    "<meta name=\"(theme-color|color-scheme)\"((?: media=\"[^\"]*\")?) content=\"([^\"]*)\">",
    "<link href=\"[^\"]*\" media=\"([^\"]*)\" rel=\"stylesheet\" class=\"((?:light|dark)-scheme)\"((?: data-scheme-id=\"[^\"]*\")?)/>"
  ]
}
