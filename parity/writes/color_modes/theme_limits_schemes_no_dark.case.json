{
  "user": "user1",
  "setup": [
    "UPDATE themes SET dark_color_scheme_id = NULL WHERE id = -1",
    "UPDATE theme_modifier_sets SET only_theme_color_schemes = true WHERE theme_id = -1"
  ],
  "requests": [
    {
      "method": "GET",
      "path": "/latest",
      "headers": {
        "Accept": "text/html",
        "X-Requested-With": ""
      }
    }
  ],
  "extract": [
    "<meta name=\"(theme-color|color-scheme)\"((?: media=\"[^\"]*\")?) content=\"([^\"]*)\">",
    "<link href=\"[^\"]*\" media=\"([^\"]*)\" rel=\"stylesheet\" class=\"((?:light|dark)-scheme)\"((?: data-scheme-id=\"[^\"]*\")?)/>"
  ]
}
