# The environment the reference agent's Rails server runs with, one
# KEY=VALUE per line; scripts/reference-env applies it.
#
# No Sidekiq, and with it no scheduler: the hourly and daily jobs (badge
# grants, rollups, directory refreshes, hot scores) kept writing to the
# reference's database, so it drifted away from seed/fresh_install.sql
# between snapshots and recordings. Jobs a recording needs run inside the
# recorder (scripts/record_writes.rb, `run_jobs`).
UNICORN_SIDEKIQS=0
