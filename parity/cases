# Requests compared against real Discourse (see parity/environment). One per line:
#   METHOD /path [ignore=/json/pointer,/list/*/field]
# Golden responses live in parity/golden/, written by `make parity-record`.

# forums#status
GET /srv/status
GET /srv/status?cluster=parity

# site#basic_info
GET /site/basic-info.json

# site#site (anonymous). Ignored until ported:
#   filters, anonymous_list_filters, homepage_choices, top_menu_items,
#   anonymous_top_menu_items: topic-voting plugin adds "votes"
#   markdown_additional_options, hashtag_configurations, hashtag_icons: chat plugin
#   access_control: boards plugin ACLs
#   categories/*/custom_fields: plugin-registered category custom fields
GET /site.json ignore=/filters,/anonymous_list_filters,/homepage_choices,/top_menu_items,/anonymous_top_menu_items,/markdown_additional_options,/hashtag_configurations,/hashtag_icons,/access_control,/categories/*/custom_fields

# list#latest (anonymous). Ignored: has_accepted_answer (solved plugin),
# can_vote (topic-voting plugin)
GET /latest.json ignore=/topic_list/topics/*/has_accepted_answer,/topic_list/topics/*/can_vote
GET /latest.json?page=1&per_page=2 ignore=/topic_list/topics/*/has_accepted_answer,/topic_list/topics/*/can_vote
# order=views would tie (all 0) and Discourse has no tiebreaker.
GET /latest.json?order=created&ascending=true ignore=/topic_list/topics/*/has_accepted_answer,/topic_list/topics/*/can_vote

