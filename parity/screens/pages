# The users directory. Its numbers and Last Updated come from each
# side's last directory_refresh: the port's screens server runs no jobs,
# so compare after both have refreshed (or copy the reference's
# directory_items and directory_<period> timestamps across); the dates
# are the browser's on the reference and UTC on the port.
/u mask=.top-date-string,.directory-last-updated
/u as=user1 mask=.top-date-string,.directory-last-updated
/u as=admin mask=.top-date-string,.directory-last-updated
/u?order=topic_count&asc=true&period=all as=admin mask=.top-date-string,.directory-last-updated
/u?period=fortnightly

