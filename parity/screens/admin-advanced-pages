# The advanced and customize admin pages (90g8, 90g7), as admin; see
# parity/screens/pages for the format. Kept apart from admin-pages so the
# 90g areas' lists merge cleanly.
# Backups (90g8). Masked: nothing; the reference lists no backup files on
# a fresh install, as the port's screens database doesn't.
/admin/backups as=admin
/admin/backups/logs as=admin
/admin/backups/settings as=admin
# API keys (90g8). Masked: the keys' relative dates and truncated keys,
# which differ by when and as what each side created them.
/admin/api/keys as=admin mask=.relative-date,.key>.d-table__value-wrapper
/admin/api/keys/new as=admin
/admin/api/keys/settings as=admin
# Web hooks (90g8). A fresh install has none, so only the list and the
# new hook's form; a hook's own pages are in tests/admin_advanced_pages.
/admin/api/web_hooks as=admin
/admin/api/web_hooks/new as=admin
# Email (90g8). Masked: the delivery settings, which are the environment's,
# and the summary, which is as of the day.
/admin/email as=admin
/admin/email/server-settings as=admin mask=.server-settings>.admin-container>.table
/admin/email/preview-digest as=admin mask=.preview-output
/admin/email/advanced-test as=admin
/admin/email/templates as=admin
# Problem checks (90g8). Masked: the trackers, which the reference's
# scheduler writes and the seed has none of.
/admin/problem-checks as=admin mask=.admin-problem-checks__items>tbody
# Badges (90g8).
/admin/badges as=admin
/admin/badges/settings as=admin
/admin/badges/1 as=admin
/admin/badges/new as=admin
/admin/badges/award/new as=admin
/admin/badges/award/1 as=admin
# Installed plugins (90g8).
/admin/plugins as=admin
/admin/plugins/poll as=admin
# Customize (90g7): watched words, robots.txt, embedding, site texts.
# Masked: robots.txt's text, whose sitemap line names the request's host.
/admin/customize/watched_words/action/block as=admin
/admin/customize/watched_words/action/replace as=admin
/admin/customize/watched_words/action/tag as=admin
/admin/customize/robots as=admin mask=.robots-txt-input
/admin/customize/embedding as=admin
/admin/customize/embedding/settings as=admin
/admin/customize/embedding/posts_and_topics as=admin
/admin/customize/embedding/crawlers as=admin
/admin/customize/embedding/new as=admin
/admin/customize/site_texts as=admin
/admin/customize/site_texts?q=topic&overridden=true as=admin
/admin/customize/site_texts/education.new-reply?locale=en as=admin
# The email template editor (90g7, with the site texts' overrides).
/admin/email/templates/user_notifications.signup as=admin
/admin/email/templates/system_messages.pending_users_reminder as=admin
# Color palettes (90g7): the list, a palette's editor, a theme's palette.
/admin/config/colors as=admin
/admin/config/colors?type=from_theme as=admin
/admin/config/colors/13 as=admin
/admin/config/colors/1 as=admin
# Email style and form templates (90g7), their editors Ace.
/admin/customize/email_style/html as=admin
/admin/customize/email_style/css as=admin
/admin/customize/form-templates as=admin
/admin/customize/form-templates/new as=admin
# Themes and components (90g7). Masked: a theme without screenshots,
# whose placeholder drawing Ember picks at random.
/admin/config/customize/themes as=admin mask=.theme-card-preview__image-wrapper>svg
/admin/config/customize/components as=admin
/admin/config/customize/theme-site-settings as=admin
