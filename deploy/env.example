# /etc/discourse-rs/env, read by discourse-rs.service. Holds a secret:
# keep it 0640 root:discourse-rs.

# The restored backup's database (scripts/restore-backup). Over the local
# socket with peer auth, the role is the service user: createuser discourse-rs
DATABASE_URL=postgresql:///discourse?host=/run/postgresql

# Loopback only: the server trusts X-Forwarded-For, so nothing but the
# reverse proxy may reach it.
BIND_ADDR=127.0.0.1:8080

RAILS_ENV=production
DISCOURSE_HOSTNAME=forum.example.com
# https in generated URLs and Secure on the session cookie. A backup of a
# site that already had force_https on does not need this.
DISCOURSE_FORCE_HTTPS=true

# Must be the Rails site's value for its sessions to survive a cutover.
# Rails keeps it in redis when it is not configured:
#   rails runner 'puts GlobalSetting.safe_secret_key_base'
# For a mirror with no Rails side: openssl rand -hex 64
# Without it sessions die with every restart.
DISCOURSE_SECRET_KEY_BASE=

# The backup's uploads/ and images/ (the dest dir of scripts/restore-backup).
PUBLIC_DIR=/var/lib/discourse-rs/public
# Optional: a Discourse checkout with its bundle installed, for the stock
# images and the emoji set a backup doesn't carry.
#DISCOURSE_SRC=/var/lib/discourse-rs/discourse

RUST_LOG=info
