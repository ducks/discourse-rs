# /etc/discourse-rs/env, read by discourse-rs.service. Holds a secret:
# keep it 0640 root:discourse-rs.

# The site's database (made by `discourse-rs setup`, or a backup restored by
# scripts/restore-backup). Over the local socket with peer auth, the role
# is the process's user: createuser discourse-rs
DATABASE_URL=postgresql:///discourse?host=/run/postgresql

# Loopback only: the server trusts X-Forwarded-For, so nothing but the
# reverse proxy may reach it.
BIND_ADDR=127.0.0.1:8080

RAILS_ENV=production
DISCOURSE_HOSTNAME=forum.example.com
# https in generated URLs and Secure on the session cookie. A backup of a
# site that already had force_https on does not need this.
DISCOURSE_FORCE_HTTPS=true
# Optional, a new site: who may register the first admin on the finish
# installation page (comma separated; it needs an SMTP relay, the
# DISCOURSE_SMTP_* variables, for the activation email).
#DISCOURSE_DEVELOPER_EMAILS=you@example.com

# Must be the Rails site's value for its sessions to survive a cutover.
# Rails keeps it in redis when it is not configured:
#   rails runner 'puts GlobalSetting.safe_secret_key_base'
# For a site with no Rails side: openssl rand -hex 64
# Without it the server generates one and keeps it in the database, as
# Rails keeps it in redis.
DISCOURSE_SECRET_KEY_BASE=

# The backup's uploads/ and images/ (the dest dir of scripts/restore-backup).
PUBLIC_DIR=/var/lib/discourse-rs/public
# Where backups and restores are staged and the letter avatar cache kept.
TMP_DIR=/var/lib/discourse-rs/tmp
# Standard emoji assets: deploy/install-emoji /var/lib/discourse-rs/public
# Optional: a Discourse checkout with its bundle installed, for stock
# images and an alternative source of standard emoji images.
#DISCOURSE_SRC=/var/lib/discourse-rs/discourse
# Optional: the font local letter avatars are drawn with when
# external_system_avatars_url is blank (apt install fonts-urw-base35).
#LETTER_AVATAR_FONT=/usr/share/fonts/opentype/urw-base35/NimbusSans-Regular.otf

# Optional: more forums from this process, by hostname (deploy/multisite.yml.example,
# docs/multisite.md). The sites share PUBLIC_DIR, each under its db key.
#DISCOURSE_MULTISITE_CONFIG_PATH=/etc/discourse-rs/multisite.yml
# Optional: the default site's pool (10); a multisite.yml entry sets its own.
#DISCOURSE_DB_POOL=10

RUST_LOG=info
