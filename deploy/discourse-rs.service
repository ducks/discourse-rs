[Unit]
Description=discourse-rs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=discourse-rs
Group=discourse-rs
EnvironmentFile=/etc/discourse-rs/env
ExecStart=/usr/local/bin/discourse-rs
Restart=on-failure
RestartSec=2

# The server reads /etc/discourse-rs and writes under /var/lib/discourse-rs
# (uploads, backups, TMP_DIR); the rest of the system is read only to it.
StateDirectory=discourse-rs
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
