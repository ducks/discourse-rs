#!/usr/bin/env bash
#
# Process-level numbers for a discourse-rs binary: size, time from exec
# to the first 200 on /srv/status, and RSS after a warm-up of the main
# pages. The server's configuration comes from the environment, as for
# any run (DATABASE_URL, PUBLIC_DIR, DISCOURSE_SRC, RAILS_ENV, ...);
# BIND_ADDR is set here.
#
# Usage: scripts/bench-startup [binary] [bind]
#   defaults: target/release/discourse-rs, 127.0.0.1:8090

set -euo pipefail

binary="${1:-target/release/discourse-rs}"
bind="${2:-127.0.0.1:8090}"
[ -x "$binary" ] || { echo "bench-startup: $binary not found (make release-build)" >&2; exit 2; }

size=$(stat -c %s "$binary")
start=$(date +%s%N)
BIND_ADDR="$bind" "$binary" >/dev/null 2>&1 &
pid=$!
trap 'kill $pid 2>/dev/null || true' EXIT
until curl -sf "http://$bind/srv/status" >/dev/null 2>&1; do
  kill -0 $pid 2>/dev/null || { echo "bench-startup: server exited" >&2; exit 1; }
  sleep 0.01
done
ready_ms=$(( ($(date +%s%N) - start) / 1000000 ))
rss_idle=$(ps -o rss= -p $pid | tr -d ' ')

for path in /latest.json /latest /site.json /categories.json /search.json?q=the; do
  for _ in $(seq 1 20); do curl -sf "http://$bind$path" >/dev/null || true; done
done
rss_warm=$(ps -o rss= -p $pid | tr -d ' ')

echo "| measure | value |"
echo "|---|---:|"
echo "| binary size | $(( size / 1024 / 1024 )) MB ($size bytes) |"
echo "| exec to first 200 | $ready_ms ms |"
echo "| RSS idle | $(( rss_idle / 1024 )) MB |"
echo "| RSS after 100 requests | $(( rss_warm / 1024 )) MB |"
