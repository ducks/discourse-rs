#!/usr/bin/env bash
# Record what Rails cooks for chat messages (Chat::Message.cook: the chat
# markdown features and rules, slash commands, cached oneboxes) on the
# reference agent into parity/chat_cook/corpus.json, which
# tests/chat_cook.rs cooks again and compares. The samples are in
# scripts/chat_cook_export.rb.
#
# Usage: scripts/record-chat-cooks <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi
agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
dv copy "$root/scripts/chat_cook_export.rb" "$agent:/tmp/chat_cook_export.rb" > /dev/null
dv run --name "$agent" -- rm -rf /tmp/chat-cook-record
dv run --name "$agent" -- bin/rails runner /tmp/chat_cook_export.rb /tmp/chat-cook-record | tail -1
dv copy "$agent:/tmp/chat-cook-record/corpus.json" "$root/parity/chat_cook/corpus.json" > /dev/null
