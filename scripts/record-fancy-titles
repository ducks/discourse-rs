#!/usr/bin/env bash
# Record HtmlPrettify on the strings of Discourse's
# spec/lib/html_prettify_spec.rb and Topic.fancy_title on the titles in
# parity/fancy_title/extra.json, from the reference agent, into
# parity/fancy_title/expected.json (scripts/fancy_title_export.rb,
# read-only). tests/fancy_title.rs runs the same inputs.
#
# Usage: scripts/record-fancy-titles <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi

agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
dir="$root/parity/fancy_title"

dv copy "$root/scripts/fancy_title_export.rb" "$agent:/tmp/fancy_title_export.rb" > /dev/null
dv copy "$dir/extra.json" "$agent:/tmp/fancy_title_extra.json" > /dev/null
dv run --name "$agent" -- bin/rails runner /tmp/fancy_title_export.rb \
  spec/lib/html_prettify_spec.rb /tmp/fancy_title_extra.json /tmp/fancy_title_expected.json | tail -1
dv copy "$agent:/tmp/fancy_title_expected.json" "$dir/expected.json" > /dev/null
echo "wrote $dir/expected.json"
