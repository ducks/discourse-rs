#!/usr/bin/env bash
# Record the reference's English translation tree, in its search order, into
# vendor/discourse/config/locales/i18n_tree.en.json for the admin site texts
# search (src/site_texts.rs). Run after vendoring, from an agent at the
# vendored commit with the bundled plugins.
#
# Usage: scripts/record-i18n-tree <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi
agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
commit="$(dv run --name "$agent" -- git -C /var/www/discourse rev-parse HEAD)"
vendored="$(sed -n 's/^commit=//p' "$root/vendor/discourse/DISCOURSE_REF")"
if [ "$commit" != "$vendored" ]; then
  echo "agent $agent runs Discourse $commit but vendor/ is from $vendored" >&2
  exit 1
fi
dv copy "$root/scripts/i18n_tree_export.rb" "$agent:/tmp/i18n_tree_export.rb" > /dev/null
dv run --name "$agent" -- bin/rails runner /tmp/i18n_tree_export.rb /tmp/i18n_tree.en.json | tail -1
dv copy "$agent:/tmp/i18n_tree.en.json" "$root/vendor/discourse/config/locales/i18n_tree.en.json" > /dev/null
