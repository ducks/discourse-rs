#!/usr/bin/env bash
# Record what /admin/plugins.json says of the bundled plugins (apart from
# `enabled`) from a reference agent into vendor/discourse/config/
# admin_plugins.json, for the installed plugins pages
# (src/admin_plugins.rs). Run after vendoring, from an agent at the
# vendored commit with the bundled plugins.
#
# Usage: scripts/record-admin-plugins <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi
agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
commit="$(dv run --name "$agent" -- git -C /var/www/discourse rev-parse HEAD)"
vendored="$(sed -n 's/^commit=//p' "$root/vendor/discourse/DISCOURSE_REF")"
if [ "$commit" != "$vendored" ]; then
  echo "agent $agent runs Discourse $commit but vendor/ is from $vendored" >&2
  exit 1
fi
dv copy "$root/scripts/admin_plugins_export.rb" "$agent:/tmp/admin_plugins_export.rb" > /dev/null
dv run --name "$agent" -- bin/rails runner /tmp/admin_plugins_export.rb /tmp/admin_plugins.json | tail -1
dv copy "$agent:/tmp/admin_plugins.json" "$root/vendor/discourse/config/admin_plugins.json" > /dev/null
