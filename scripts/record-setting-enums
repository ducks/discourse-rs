#!/usr/bin/env bash
# Record the site settings' Ruby-computed values (enum classes, choices
# expressions) from a reference agent into
# vendor/discourse/config/setting_enums.json, for the admin site settings
# list (src/admin_site_settings.rs). Run after vendoring, from an agent at
# the vendored commit with the bundled plugins.
#
# Usage: scripts/record-setting-enums <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi
agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
commit="$(dv run --name "$agent" -- git -C /var/www/discourse rev-parse HEAD)"
vendored="$(sed -n 's/^commit=//p' "$root/vendor/discourse/DISCOURSE_REF")"
if [ "$commit" != "$vendored" ]; then
  echo "agent $agent runs Discourse $commit but vendor/ is from $vendored" >&2
  exit 1
fi
dv copy "$root/scripts/setting_enums_export.rb" "$agent:/tmp/setting_enums_export.rb" > /dev/null
dv run --name "$agent" -- bin/rails runner /tmp/setting_enums_export.rb /tmp/setting_enums.json | tail -1
dv copy "$agent:/tmp/setting_enums.json" "$root/vendor/discourse/config/setting_enums.json" > /dev/null
