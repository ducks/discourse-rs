#!/usr/bin/env bash
# Vendor db/structure.sql from a Discourse checkout at a committed revision.
#
# Discourse owns the schema; discourse-rs never writes migrations. This copies
# structure.sql as committed at REF (default HEAD) so local, uncommitted
# plugin migrations in the checkout never leak into the vendored file, and
# records the revision in schema/DISCOURSE_REF.
#
# Usage: scripts/vendor-schema <path-to-discourse> [ref]
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: $0 <path-to-discourse> [ref]" >&2
  exit 64
fi

src="$1"
ref="${2:-HEAD}"
root="$(cd "$(dirname "$0")/.." && pwd)"

commit="$(git -C "$src" rev-parse --verify "$ref^{commit}")"
committed_at="$(git -C "$src" show -s --format=%cI "$commit")"

mkdir -p "$root/schema"
git -C "$src" show "$commit:db/structure.sql" > "$root/schema/structure.sql"

cat > "$root/schema/DISCOURSE_REF" <<EOF
commit=$commit
committed_at=$committed_at
EOF

versions="$(grep -cE "^\('[0-9]+'\)[,;]$" "$root/schema/structure.sql")"
echo "vendored structure.sql from $commit ($committed_at), $versions schema versions"
