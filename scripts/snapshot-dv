#!/usr/bin/env bash
# Snapshot a dv agent's database into seed/fresh_install.sql, or with
# --clean into seed/clean_install.sql.
#
# fresh_install.sql is the data a freshly provisioned dv agent has: what
# db/fixtures and dv's dev seeds create, plus scripts/fixtures/*.rb. Loaded
# on top of the vendored structure.sql it gives Rust the exact database the
# parity golden files were recorded from, so the same agent must be used to
# record them (see parity/environment).
#
# clean_install.sql is what a production install has after `rake
# db:migrate` (the migrations, then db:seed): a scratch database in the
# agent, discourse_clean, is dropped, created and migrated, and nothing
# else touches it. `discourse-rs setup` loads it. Left out of it, on top of
# the exclusions below: what db:seed derives from the environment or
# generates at random, which setup makes for the site instead (the VAPID
# keys and push_api_secret_key, notification_email from the hostname,
# api_key_last_used_epoch, the login hint from DISCOURSE_DEVELOPER_EMAILS,
# the system and discobot users' random passwords and their email tokens).
# It is seeded under a placeholder hostname, which setup replaces with the
# site's.
# It is dumped without --disable-triggers (pg_dump orders the tables for
# their foreign keys instead), so a database owner that is not a superuser
# can load it.
#
# Excluded from both: schema_migrations and ar_internal_metadata
# (structure.sql fills them), the compiled asset caches (5 MB of CSS/JS
# nothing reads yet), and the scheduler bookkeeping tables that change
# every minute, and search_logs (every probe of the reference leaves rows
# there) and the auth tokens (every parity login does too). pg_dump 15+
# emits a random \restrict token per run; it is stripped so re-snapshots
# diff cleanly.
#
# Fixture data for the agent comes from scripts/fixtures/*.rb, applied with
# `dv copy <file> <agent>:/tmp/f.rb && dv run -- bin/rails runner /tmp/f.rb`.
#
# Usage: scripts/snapshot-dv [--clean] <agent-name>
set -euo pipefail

clean=0
if [ "${1:-}" = "--clean" ]; then
  clean=1
  shift
fi
if [ $# -ne 1 ]; then
  echo "usage: $0 [--clean] <agent-name>" >&2
  exit 64
fi

agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"

commit="$(dv run --name "$agent" -- git -C /var/www/discourse rev-parse HEAD)"
vendored="$(sed -n 's/^commit=//p' "$root/vendor/discourse/DISCOURSE_REF")"
if [ "$commit" != "$vendored" ]; then
  echo "agent $agent runs Discourse $commit but vendor/discourse is at $vendored" >&2
  echo "re-vendor first: scripts/vendor-discourse <discourse-checkout> $commit" >&2
  exit 1
fi

excludes=(
  --exclude-table=schema_migrations
  --exclude-table=ar_internal_metadata
  --exclude-table=stylesheet_cache
  --exclude-table=javascript_caches
  --exclude-table=scheduler_stats
  --exclude-table=problem_check_trackers
  --exclude-table=search_logs
  --exclude-table=user_auth_tokens
  --exclude-table=user_auth_token_logs
)

if [ "$clean" -eq 0 ]; then
  out="$root/seed/fresh_install.sql"
  {
    echo "-- Generated by scripts/snapshot-dv from dv agent '$agent' at Discourse $commit."
    echo "-- Do not edit; re-run the script."
    dv run --name "$agent" -- pg_dump --data-only --no-owner --no-privileges --disable-triggers \
      "${excludes[@]}" discourse_development | grep -vE '^\\(un)?restrict '
  } > "$out"
  echo "wrote $out ($(wc -c < "$out") bytes, $(grep -c '^COPY ' "$out") tables)"
  exit 0
fi

out="$root/seed/clean_install.sql"
db=discourse_clean
snapshot=discourse_clean_snapshot
# Discourse.current_hostname while seeding: the admin guide topic links to
# Discourse.base_url and topic_links keep the domain. setup puts the
# site's own in its place (src/setup.rs, SEED_HOSTNAME).
host=setup.discourse-rs.invalid

# The site settings db:seed sets from the environment or at random
# (db/fixtures/990_settings.rb, 991_vapid_keys.rb, 992_push_api_secret_key.rb,
# 993_login_hint.rb); src/setup.rs makes them.
scrub="DELETE FROM site_settings WHERE name IN (
  'vapid_public_key', 'vapid_private_key', 'vapid_public_key_bytes', 'vapid_base_url',
  'push_api_secret_key', 'notification_email', 'api_key_last_used_epoch',
  'global_notice', 'has_login_hint')"

dv run --name "$agent" -- bash -c "
  set -euo pipefail
  cd /var/www/discourse
  dropdb --if-exists $snapshot
  dropdb --if-exists $db
  createdb --template=template0 --locale=en_US.UTF-8 $db
  env -u DISCOURSE_DEVELOPER_EMAILS -u DISCOURSE_PORT DISCOURSE_HOSTNAME=$host DISCOURSE_DEV_DB=$db \
    bin/rake db:migrate > /tmp/clean-migrate.log 2>&1 \
    || { cat /tmp/clean-migrate.log >&2; exit 1; }
  createdb --template=$db $snapshot
  psql -X -q -v ON_ERROR_STOP=1 -d $snapshot -c \"$scrub\"
"
{
  echo "-- Generated by scripts/snapshot-dv --clean from dv agent '$agent' at Discourse $commit:"
  echo "-- rake db:migrate (the migrations and db:seed) into an empty database. Do not edit; re-run the script."
  dv run --name "$agent" -- pg_dump --data-only --no-owner --no-privileges \
    "${excludes[@]}" \
    --exclude-table=user_passwords \
    --exclude-table=email_tokens \
    "$snapshot" | grep -vE '^\\(un)?restrict '
} > "$out"
dv run --name "$agent" -- bash -c "dropdb $snapshot && dropdb $db"

echo "wrote $out ($(wc -c < "$out") bytes, $(grep -c '^COPY ' "$out") tables)"
