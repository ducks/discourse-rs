#!/usr/bin/env bash
# Write vendor/autoprefixer/discourse-browsers.json: autoprefixer's prefix
# tables for Discourse's browsers as the reference's asset processor
# selects them (scripts/autoprefixer_export.cjs, read-only), which
# src/stylesheet/autoprefixer.rs runs on. Run it again after the
# reference's autoprefixer, caniuse-lite or targets.js change.
#
# Usage: scripts/record-autoprefixer-data <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi

agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/vendor/autoprefixer/discourse-browsers.json"

dv copy "$root/scripts/autoprefixer_export.cjs" "$agent:/tmp/autoprefixer_export.cjs" > /dev/null
dv run --name "$agent" -- node /tmp/autoprefixer_export.cjs > "$dest"
dv run --name "$agent" -- rm -f /tmp/autoprefixer_export.cjs
echo "wrote $dest"
