  user-pen
  user-plus
  # discourse-local-dates: the date, its preview and the calendar modal.
  earth-americas
  file
  download
  fab-google
  fab-microsoft
  fab-apple
  # The about page's stats and site activity.
  calendar-days
  scroll
  comment-dots
  # The groups pages: closed groups, leaving one, the permissions tab.
  ban
  user-xmark
  id-card
  # The mobile view's chat: the chat header's way back, the footer's channels.
  arrow-left
  comments
  # The admin sidebar's links and the dashboard's sections.
  gift
  flask
  wand-magic
  triangle-exclamation
  far-circle-question
  arrow-right
  up-right-from-square
  database
  chart-pie
  chart-bar
  circle-user
  user-gear
  eye
  screwdriver-wrench
  gavel
  font
  palette
  discourse-table
  diagram-project
  paintbrush
  sign-hanging
  language
  square-envelope
  robot
  puzzle-piece
  key
  plug
  rocket
  discourse-sparkles
  circle-check
  grip-vertical
  chevron-right
  # The admin's user page.
  power-off
  far-rectangle-list
  unlock-keyhole
  microphone-slash
  crosshairs
  left-right
  # The bundled plugins' admin links (setAdminPluginIcon).
  asterisk
  bed
  far-clipboard
  code-branch
  wand-magic-sparkles
  boards=plugin-boards
  rectangle-ad
  chart-line
  fab-github
  graduation-cap
  square-root-variable
  fab-patreon
  rss
  far-credit-card
  pen-to-square
  headset
  microphone-lines
  gif
  # The preferences navigation and its tabs.
  address-card
  desktop
  bell-slash
  play
  fab-linux
  fab-android
  fab-windows
  fab-chrome
  question
  caret-down
  caret-up
)

root="$(cd "$(dirname "$0")/.." && pwd)"

fa="$root/vendor/discourse/vendor/assets/svg-icons/fontawesome"
version=$(grep -o 'Font Awesome Free [0-9.]*' "$fa/solid.svg" | head -1)

# The <symbol> named $2 in sprite $1, on one line.
symbol() {
  tr -d '\n' < "$1" | grep -o "<symbol id=[\"']$2[\"'][^>]*>.*" | sed 's|</symbol>.*|</symbol>|'
}

out="$root/static/vendor/icons.svg"
{
  echo "<!-- $version by @fontawesome - https://fontawesome.com"
  echo "     License - https://fontawesome.com/license/free (Icons: CC BY 4.0)"
  echo "     Copyright 2024 Fonticons, Inc. The discourse-* icons are Discourse's"
  echo "     (vendor/discourse/vendor/assets/svg-icons, GPL-2.0), and so are the"
  echo "     bundled plugins' (vendor/discourse/plugins/*/svg-icons). Built by"
  echo "     scripts/build-icon-sprite. -->"
  echo '<svg xmlns="http://www.w3.org/2000/svg" style="display: none">'
  for icon in "${ICONS[@]}"; do
    name="${icon%%=*}"
    file="${icon#*=}"
    # Discourse's own icons (discourse-*, float-kit's arrow, and the gif
    # icon the admin's GIFs link takes), from its vendored sprite.
    if [[ $file == discourse-* || $file == tippy-rounded-arrow || $file == gif ]]; then
      tr -d '\n' < "$root/vendor/discourse/vendor/assets/svg-icons/discourse-additional.svg" \
        | grep -o "<symbol id=[\"']$file[\"'][^>]*>.*" | sed 's|</symbol>.*|</symbol>|' | sed "s/^/  /"
      continue
    fi
    # A bundled plugin's own icons, from its vendored svg-icons sprite.
    if [[ $file == plugin-* ]]; then
      cat "$root"/vendor/discourse/plugins/*/svg-icons/*.svg | tr -d '\n' \
        | grep -o "<symbol id=[\"']${file#plugin-}[\"'][^>]*>.*" | sed 's|</symbol>.*|</symbol>|' | sed "s/^/  /"
      continue
    fi
    # Discourse names the regular style's icons far-<name>, the brands'
    # fab-<name>; the vendored sprites name them plainly.
    case $file in
      far-*) sprite="$fa/regular.svg" id="${file#far-}" ;;
      fab-*) sprite="$fa/brands.svg" id="${file#fab-}" ;;
      *) sprite="$fa/solid.svg" id="$file" ;;
    esac
    found=$(symbol "$sprite" "$id")
    if [ -z "$found" ]; then
      echo "no icon $id in $(basename "$sprite") ($version)" >&2
      exit 1
    fi
    echo "  ${found/<symbol id=\"$id\"/<symbol id=\"$name\"}"
  done
  echo '</svg>'
} > "$out"
echo "wrote $out (${#ICONS[@]} icons)" >&2
