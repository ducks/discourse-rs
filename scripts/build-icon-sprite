#!/usr/bin/env bash
# Build static/vendor/icons.svg: the Font Awesome Free icons the pages use,
# as <symbol>s named as Discourse names them (<use href="#bars">), from the
# sprites Discourse vendors and serves (vendor/assets/svg-icons/fontawesome,
# Font Awesome Free 6.6.0 at the vendored commit; SvgSprite builds the
# page's sprite from these, not from the npm package). Icons are CC BY 4.0
# (static/vendor/fontawesome-LICENSE.txt).
#
# Usage: scripts/build-icon-sprite
#   The icons are listed below as "name" or "name=fontawesome-file";
#   plugin-<name> is a bundled plugin's icon, from its vendored sprite.
set -euo pipefail

ICONS=(
  bars
  user
  envelope
  thumbtack
  lock
  angle-right
  bell
  magnifying-glass
  angle-down
  layer-group
  ellipsis-vertical
  list
  list-check
  list-ul
  clock-rotate-left
  clock
  arrow-rotate-left
  arrows-rotate
  user-plus
  tags
  tag
  keyboard
  users
  user-group
  circle-info
  circle-question
  certificate
  filter
  inbox
  flag
  wrench
  paper-plane
  circle
  link
  pencil
  heart
  far-heart
  bookmark
  far-bookmark
  reply
  share
  shield-halved
  far-envelope
  unlock
  folder
  folder-open
  far-eye
  far-eye-slash
  right-from-bracket
  circle-plus
  circle-minus
  comment
  hand-point-right
  exclamation
  trash-can
  user-shield
  far-pen-to-square
  far-image
  upload
  chevron-down
  arrow-up-from-bracket
  book-open-reader
  ellipsis
  discourse-expand
  discourse-compress
  discourse-bookmark-clock
  discourse-bell-exclamation
  discourse-chevron-expand
  discourse-bell-slash
  discourse-bell-one
  far-bell
  minus
