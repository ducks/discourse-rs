  fab-discourse
  check-to-slot
  toggle-on
  toggle-off
  far-face-smile
  far-square-check
  square-check
  check
  chevron-up
  far-square
  hand
  plugin-vote-up
  plugin-vote-up-filled
  arrow-down
  chevron-left
  far-star
  star
  discourse-chat-search
  comment-slash
  box-archive
  filter-circle-xmark
  discourse-emojis
  circle-exclamation
  rotate
  circle-xmark
  copy
  arrow-up
  tippy-rounded-arrow
  # The user card: the local time, and the badges' icons (badges.icon).
  far-clock
  at
  bullhorn
  cake-candles
  calendar
  calendar-week
  circle-nodes
  compass
  cube
  face-smile
  file-lines
  file-signature
  handshake
  house
  magnet
  medal
  microphone
  moon
  pen
  people-group
  share-nodes
  stamp
  sun
