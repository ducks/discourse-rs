#!/usr/bin/env bash
# Build static/vendor/icons.svg: the Font Awesome Free icons the pages use,
# as <symbol>s named as Discourse names them (<use href="#bars">), from the
# npm package Discourse depends on. The tarball is checked against its npm
# integrity first. Icons are CC BY 4.0 (static/vendor/fontawesome-LICENSE.txt).
#
# Usage: scripts/build-icon-sprite
#   The icons are listed below as "name" or "name=fontawesome-file".
set -euo pipefail

VERSION=7.3.1
ICONS=(
  bars
  user
  envelope
  thumbtack
  lock
  angle-right
  bell
  magnifying-glass
  angle-down
  layer-group
  ellipsis-vertical
  list
  tag
  keyboard
  users
  user-group
  circle-info
  circle-question
  certificate
  filter
  inbox
  flag
  wrench
  paper-plane
  circle
  link
  pencil
  heart
  far-heart
  bookmark
  far-bookmark
  reply
  share
  shield-halved
  far-envelope
  unlock
  folder
  folder-open
  far-eye
  far-eye-slash
  right-from-bracket
  circle-plus
  circle-minus
  comment
  hand-point-right
  exclamation
  trash-can
  user-shield
  far-pen-to-square
  far-image
  upload
  chevron-down
  arrow-up-from-bracket
  book-open-reader
  ellipsis
  discourse-expand
  discourse-compress
  discourse-bookmark-clock
  minus
  xmark
  bold
  italic
  quote-right
  code
  angle-up
  angles-left
  bars-staggered
  gear
  angles-down
  angles-up
  location-dot
  globe
  sliders
)

root="$(cd "$(dirname "$0")/.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

url="https://registry.npmjs.org/@fortawesome/fontawesome-free/-/fontawesome-free-$VERSION.tgz"
want=$(curl -sf "https://registry.npmjs.org/@fortawesome/fontawesome-free/$VERSION" | jq -r .dist.integrity)
curl -sfL "$url" -o "$work/fa.tgz"
got="sha512-$(openssl dgst -sha512 -binary "$work/fa.tgz" | base64 -w0)"
if [ "$want" != "$got" ]; then
  echo "integrity mismatch: $want != $got" >&2
  exit 1
fi
tar xzf "$work/fa.tgz" -C "$work"

out="$root/static/vendor/icons.svg"
{
  echo "<!-- Font Awesome Free $VERSION by @fontawesome - https://fontawesome.com"
  echo "     License - https://fontawesome.com/license/free (Icons: CC BY 4.0)"
  echo "     Copyright 2026 Fonticons, Inc. The discourse-* icons are Discourse's"
  echo "     (vendor/discourse/vendor/assets/svg-icons, GPL-2.0). Built by"
  echo "     scripts/build-icon-sprite. -->"
  echo '<svg xmlns="http://www.w3.org/2000/svg" style="display: none">'
  for icon in "${ICONS[@]}"; do
    name="${icon%%=*}"
    file="${icon#*=}"
    # Discourse's own icons (discourse-*), from its vendored sprite.
    if [[ $file == discourse-* ]]; then
      tr -d '\n' < "$root/vendor/discourse/vendor/assets/svg-icons/discourse-additional.svg" \
        | grep -o "<symbol id=\"$file\"[^>]*>.*" | sed 's|</symbol>.*|</symbol>|' | sed "s/^/  /"
      continue
    fi
    # Discourse names the regular style's icons far-<name>.
    if [[ $file == far-* ]]; then
      svg="$work/package/svgs/regular/${file#far-}.svg"
    else
      svg="$work/package/svgs/solid/$file.svg"
    fi
    view_box=$(grep -o 'viewBox="[^"]*"' "$svg")
    body=$(sed -e 's/<svg[^>]*>//' -e 's/<\/svg>//' -e 's/<!--[^>]*-->//' "$svg")
    echo "  <symbol id=\"$name\" $view_box>$body</symbol>"
  done
  echo '</svg>'
} > "$out"
cp "$work/package/LICENSE.txt" "$root/static/vendor/fontawesome-LICENSE.txt"
echo "wrote $out (${#ICONS[@]} icons)" >&2
