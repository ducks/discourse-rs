#!/usr/bin/env bash
# Drops the test databases whose test process is gone: tests/common/mod.rs
# names each copy <template>_<pid>_<n> and sends its DROP without waiting,
# so a killed run or a drop cut short leaves copies behind (33 MB each).
# Copies of a live process are left alone, so this is safe while other
# test runs are going.
#
#   scripts/drop-stale-test-dbs            # TEST_DATABASE_URL's template
set -euo pipefail

url=${TEST_DATABASE_URL:?TEST_DATABASE_URL must be set; run inside nix-shell}
template=$(sed -E 's|^[a-z]+://[^/]*/([^?]*).*|\1|' <<<"$url")
admin=$(sed -E "s|^([a-z]+://[^/]*/)[^?]*|\1postgres|" <<<"$url")

dropped=0
while read -r db; do
  [[ $db =~ ^${template}_([0-9]+)_[0-9]+$ ]] || continue
  if ! kill -0 "${BASH_REMATCH[1]}" 2>/dev/null; then
    psql "$admin" -qc "DROP DATABASE IF EXISTS \"$db\" WITH (FORCE)"
    dropped=$((dropped + 1))
  fi
done < <(psql "$admin" -Atc "SELECT datname FROM pg_database WHERE datname LIKE '${template}\_%'")
echo "dropped $dropped stale copies of $template"

# WebAssembly plugins' roles (src/plugin_wasm/db.rs) are the cluster's, one
# per test database. A role whose database is gone owns nothing and drops;
# one still owning a schema somewhere (a live test's) refuses, and stays.
psql "$admin" -qAt <<'SQL'
DO $$
DECLARE r text; n int := 0;
BEGIN
  FOR r IN SELECT rolname FROM pg_roles WHERE rolname LIKE 'dpl\_%' LOOP
    BEGIN
      -- Test app roles hold this (tests/plugin_wasm_api.rs app_role); it
      -- comes back with the rollback if the role stays.
      EXECUTE format('REVOKE SET ON PARAMETER temp_file_limit FROM %I', r);
      EXECUTE format('DROP ROLE %I', r);
      n := n + 1;
    EXCEPTION WHEN dependent_objects_still_exist THEN NULL;
    END;
  END LOOP;
  RAISE NOTICE 'dropped % stale plugin roles', n;
END $$;
SQL
