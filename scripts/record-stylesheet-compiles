#!/usr/bin/env bash
# Record what Stylesheet::Compiler fed dart-sass, what it printed and what
# AssetProcessor#post_css made of it (scripts/stylesheet_compile_export.rb)
# from the reference agent into parity/stylesheets/compile: the color
# definitions of the base palette and schemes 2, 13, 14 (WCAG), 16 and 17,
# of Horizon's palettes 1 and 2 with its color_definitions field, and
# Horizon's common, desktop and mobile stylesheets, with Horizon's exported
# SCSS in horizon_files. src/stylesheet/mod.rs (compile_tests) compiles the
# same inputs. Run after vendoring, from an agent at the vendored commit
# with the seed loaded (scripts/reset-reference).
#
# Usage: scripts/record-stylesheet-compiles <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi

agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
dir="$root/parity/stylesheets/compile"

dv copy "$root/scripts/stylesheet_compile_export.rb" "$agent:/tmp/stylesheet_compile_export.rb" > /dev/null
dv run --name "$agent" -- bin/rails runner /tmp/stylesheet_compile_export.rb /tmp/stylesheet-compile | tail -1
rm -rf "$dir"
mkdir -p "$dir"
for name in $(dv run --name "$agent" -- ls /tmp/stylesheet-compile); do
  dv copy "$agent:/tmp/stylesheet-compile/$name" "$dir/$name" > /dev/null
done
dv run --name "$agent" -- rm -rf /tmp/stylesheet-compile
echo "wrote $dir"
