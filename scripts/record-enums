#!/usr/bin/env bash
# Record enums Ruby builds at runtime (UserHistory's actions and which are
# staff actions, ...) from a reference agent into
# vendor/discourse/config/enums.json (scripts/enums_export.rb). Run after
# vendoring, from an agent at the vendored commit with the bundled plugins.
#
# Usage: scripts/record-enums <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi
agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
commit="$(dv run --name "$agent" -- git -C /var/www/discourse rev-parse HEAD)"
vendored="$(sed -n 's/^commit=//p' "$root/vendor/discourse/DISCOURSE_REF")"
if [ "$commit" != "$vendored" ]; then
  echo "agent $agent runs Discourse $commit but vendor/ is from $vendored" >&2
  exit 1
fi
dv copy "$root/scripts/enums_export.rb" "$agent:/tmp/enums_export.rb" > /dev/null
dv run --name "$agent" -- bin/rails runner /tmp/enums_export.rb /tmp/enums.json | tail -1
dv copy "$agent:/tmp/enums.json" "$root/vendor/discourse/config/enums.json" > /dev/null
