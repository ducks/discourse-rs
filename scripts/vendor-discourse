#!/usr/bin/env bash
# Vendor the Discourse files discourse-rs is built against.
#
# Files are copied as committed at REF (default HEAD) into vendor/discourse/
# under their Discourse paths, so local uncommitted changes in the checkout
# (e.g. plugin migrations in structure.sql) never leak in. The revision is
# recorded in vendor/discourse/DISCOURSE_REF.
#
# Usage: scripts/vendor-discourse <path-to-discourse> [ref]
set -euo pipefail

FILES=(
  db/structure.sql
  config/site_settings.yml
  config/locales/server.en.yml
  config/locales/client.en.yml
  config/locales/server.fr.yml
  config/locales/client.fr.yml
  lib/common_passwords/10-char-common-passwords.txt
  lib/onebox/templates/discourse_topic_onebox.mustache
  lib/onebox/templates/discourse_user_onebox.mustache
  lib/onebox/templates/discourse_category_onebox.mustache
  lib/onebox/templates/_layout.mustache
  lib/onebox/templates/googlemeet.mustache
  lib/onebox/templates/preview_error_onebox.mustache
  lib/onebox/templates/preview_error_fragment_onebox.mustache
  lib/onebox/templates/allowlistedgeneric.mustache
  lib/onebox/templates/json_ld_partials/movie.mustache
  lib/onebox/templates/amazon.mustache
  lib/onebox/templates/discoursetopic.mustache
  lib/onebox/templates/github/github_body.mustache
  lib/onebox/templates/githubactions.mustache
  lib/onebox/templates/githubblob.mustache
  lib/onebox/templates/githubcommit.mustache
  lib/onebox/templates/githubfolder.mustache
  lib/onebox/templates/githubgist.mustache
  lib/onebox/templates/githubissue.mustache
  lib/onebox/templates/githubpullrequest.mustache
  lib/onebox/templates/githubrepo.mustache
  lib/onebox/templates/gitlabblob.mustache
  lib/onebox/templates/googledocs.mustache
  lib/onebox/templates/googledrive.mustache
  lib/onebox/templates/googleplayapp.mustache
  lib/onebox/templates/hackernews.mustache
  lib/onebox/templates/instagram.mustache
  lib/onebox/templates/pastebin.mustache
  lib/onebox/templates/pdf.mustache
  lib/onebox/templates/pubmed.mustache
  lib/onebox/templates/stackexchange.mustache
  lib/onebox/templates/threadsstatus.mustache
  lib/onebox/templates/twitterstatus.mustache
  lib/onebox/templates/wikimedia.mustache
  lib/onebox/templates/wikipedia.mustache
  lib/onebox/templates/xkcd.mustache
  vendor/assets/svg-icons/discourse-additional.svg
  vendor/assets/svg-icons/fontawesome/solid.svg
  vendor/assets/svg-icons/fontawesome/regular.svg
  vendor/assets/svg-icons/fontawesome/brands.svg
  # The stock site images the seed's uploads -1 to -6 are, originals of
  # the site icons' optimized copies (crate::site_icons).
  public/images/d-logo-sketch.png
  public/images/d-logo-sketch-small.png
  public/images/discourse-logo-sketch.png
  public/images/discourse-logo-sketch-small.png
  public/images/default-favicon.ico
  public/images/default-apple-touch-icon.png
  # The core themes' screenshots, which SystemThemesManager.sync! stores
  # as the seed's uploads 1 to 4 (crate::system_themes).
  themes/foundation/screenshots/light.png
  themes/foundation/screenshots/dark.png
  themes/horizon/screenshots/light.png
  themes/horizon/screenshots/dark.png
  # discourse-narrative-bot's certificates (crate::plugins::narrative_bot::
  # certificate), its public files (the images its messages show, the
  # certificates' font) and the French messages core's French carries.
  plugins/discourse-narrative-bot/lib/discourse_narrative_bot/templates/new_user.svg.erb
  plugins/discourse-narrative-bot/lib/discourse_narrative_bot/templates/advanced_user.svg.erb
  plugins/discourse-narrative-bot/config/locales/server.fr.yml
  plugins/discourse-narrative-bot/public/fonts/GreatVibes-Regular.ttf
  plugins/discourse-narrative-bot/public/fonts/OFL.txt
  plugins/discourse-narrative-bot/public/images/capybara-eating.gif
  plugins/discourse-narrative-bot/public/images/dog-walk.gif
  plugins/discourse-narrative-bot/public/images/font-awesome-bookmark.png
  plugins/discourse-narrative-bot/public/images/font-awesome-ellipsis.png
  plugins/discourse-narrative-bot/public/images/font-awesome-flag.png
  plugins/discourse-narrative-bot/public/images/font-awesome-gear.png
  plugins/discourse-narrative-bot/public/images/font-awesome-link.png
  plugins/discourse-narrative-bot/public/images/font-awesome-pencil.png
  plugins/discourse-narrative-bot/public/images/font-awesome-plus.png
  plugins/discourse-narrative-bot/public/images/font-awesome-rotate-left.png
  plugins/discourse-narrative-bot/public/images/font-awesome-search.png
  plugins/discourse-narrative-bot/public/images/font-awesome-smile.png
  plugins/discourse-narrative-bot/public/images/font-awesome-trash.png
  plugins/discourse-narrative-bot/public/images/unicorn.png
)

if [ $# -lt 1 ]; then
  echo "usage: $0 <path-to-discourse> [ref]" >&2
  exit 64
fi

src="$1"
ref="${2:-HEAD}"
root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/vendor/discourse"

commit="$(git -C "$src" rev-parse --verify "$ref^{commit}")"
committed_at="$(git -C "$src" show -s --format=%cI "$commit")"

for f in "${FILES[@]}"; do
  mkdir -p "$dest/$(dirname "$f")"
  git -C "$src" show "$commit:$f" > "$dest/$f"
done

# The core stylesheets, Stylesheet::Compiler's ASSET_ROOT: theme SCSS is
# compiled against them (Discourse's variables, mixins and functions, and
# whatever else a theme imports), and the color definitions come from them.
rm -rf "$dest/app/assets/stylesheets"
stylesheets=0
while read -r f; do
  mkdir -p "$dest/$(dirname "$f")"
  git -C "$src" show "$commit:$f" > "$dest/$f"
  stylesheets=$((stylesheets + 1))
done < <(git -C "$src" ls-tree -r --name-only "$commit" app/assets/stylesheets)
echo "vendored $stylesheets core stylesheets"

# The bundled plugins' color definitions (`register_asset "...",
# :color_definitions`), which Stylesheet::Importer appends to every color
# definitions stylesheet, listed in the order Rails loads the plugins (by
# directory name) in config/plugin_color_definitions.
color_list="$dest/config/plugin_color_definitions"
: > "$color_list"
while read -r plugin_rb; do
  name="$(echo "$plugin_rb" | cut -d/ -f2)"
  while read -r asset; do
    f="plugins/$name/assets/$asset"
    mkdir -p "$dest/$(dirname "$f")"
    git -C "$src" show "$commit:$f" > "$dest/$f"
    echo "$name $f" >> "$color_list"
  done < <(git -C "$src" show "$commit:$plugin_rb" \
    | sed -n 's/^ *register_asset "\([^"]*\)", :color_definitions.*/\1/p')
done < <(git -C "$src" ls-tree -r --name-only "$commit" plugins \
  | grep -E '^plugins/[^/]+/plugin\.rb$' | LC_ALL=C sort)
echo "vendored $(wc -l < "$color_list") plugin color definitions"

# The bundled plugins' settings, one YAML document per plugin in the order
# Rails loads them (by directory name): the plugin, the setting its
# plugin.rb names with `enabled_site_setting`, and its config/settings.yml
# verbatim under `settings`.
plugin_settings="$dest/config/plugin_settings.yml"
: > "$plugin_settings"
plugins=0
while read -r f; do
  name="$(echo "$f" | cut -d/ -f2)"
  enabled="$(git -C "$src" show "$commit:plugins/$name/plugin.rb" 2>/dev/null \
    | sed -n 's/^ *enabled_site_setting :\([a-z0-9_]*\).*/\1/p' | head -1)"
  {
    echo "---"
    echo "plugin: $name"
    echo "enabled_site_setting: ${enabled:-~}"
    echo "settings:"
    # The echo ends a file that has no trailing newline.
    { git -C "$src" show "$commit:$f"; echo; } | sed -e '/^---[[:space:]]*$/d' -e 's/^/  /'
  } >> "$plugin_settings"
  plugins=$((plugins + 1))
done < <(git -C "$src" ls-tree -r --name-only "$commit" plugins \
  | grep -E '^plugins/[^/]+/config/settings.yml$' | LC_ALL=C sort)
echo "vendored the settings of $plugins plugins"

# The bundled plugins' client translations (`js.poll.*` and the like, which
# cooking reads), one YAML document per plugin in the same order.
plugin_client="$dest/config/locales/plugin_client.en.yml"
: > "$plugin_client"
while read -r f; do
  {
    echo "--- # $f"
    { git -C "$src" show "$commit:$f"; echo; } | sed -e '/^---[[:space:]]*$/d'
  } >> "$plugin_client"
done < <(git -C "$src" ls-tree -r --name-only "$commit" plugins \
  | grep -E '^plugins/[^/]+/config/locales/client\.en\.yml$' | LC_ALL=C sort)
echo "vendored $(grep -c '^--- # ' "$plugin_client") plugin client locales"

# The bundled plugins' server translations (their site settings'
# descriptions and keywords, badge names, messages), likewise.
plugin_server="$dest/config/locales/plugin_server.en.yml"
: > "$plugin_server"
while read -r f; do
  {
    echo "--- # $f"
    { git -C "$src" show "$commit:$f"; echo; } | sed -e '/^---[[:space:]]*$/d'
  } >> "$plugin_server"
done < <(git -C "$src" ls-tree -r --name-only "$commit" plugins \
  | grep -E '^plugins/[^/]+/config/locales/server\.en\.yml$' | LC_ALL=C sort)
echo "vendored $(grep -c '^--- # ' "$plugin_server") plugin server locales"

# The bundled plugins' icon sprites (register_svg_icon draws from them).
sprites=0
while read -r f; do
  mkdir -p "$dest/$(dirname "$f")"
  git -C "$src" show "$commit:$f" > "$dest/$f"
  sprites=$((sprites + 1))
done < <(git -C "$src" ls-tree -r --name-only "$commit" plugins \
  | grep -E '^plugins/[^/]+/svg-icons/[^/]+\.svg$' | LC_ALL=C sort)
echo "vendored $sprites plugin icon sprites"

# Discourse::VERSION::STRING, for the user agent it fetches with.
version="$(git -C "$src" show "$commit:lib/version.rb" | sed -n 's/^ *STRING = "\(.*\)"$/\1/p')"

# Discourse.full_version (`git describe`), which the admin dashboard shows.
describe="$(git -C "$src" describe --match "v[0-9]*" "$commit" 2>/dev/null || echo unknown)"

cat > "$dest/DISCOURSE_REF" <<EOF
commit=$commit
committed_at=$committed_at
version=$version
describe=$describe
EOF

versions="$(grep -cE "^\('[0-9]+'\)[,;]$" "$dest/db/structure.sql")"
# The markers Email::Receiver cuts replies at (`user_notifications.
# previous_discussion` and `reply_above_line`), in every server locale:
# its regexes join the translations of all available locales. One
# `key<TAB>value` line each, the value as the YAML double-quoted it.
markers="$dest/config/email_markers.tsv"
: > "$markers"
while read -r f; do
  git -C "$src" show "$commit:$f" \
    | sed -n -E 's/^    (previous_discussion|reply_above_line): "(.*)"$/\1\t\2/p' >> "$markers"
done < <(git -C "$src" ls-tree -r --name-only "$commit" config/locales \
  | grep -E '^config/locales/server\.[^./]+\.yml$' | LC_ALL=C sort)
echo "vendored $(wc -l < "$markers") email reply markers"

echo "vendored ${#FILES[@]} files from $commit ($committed_at), $versions schema versions"

# Emoji names/codes come from the discourse-emojis gem at the version in
# Gemfile.lock, read from the checkout's bundle (not committed to Discourse).
gem_version="$(git -C "$src" show "$commit:Gemfile.lock" | sed -n 's/^    discourse-emojis (\(.*\))$/\1/p' | head -1)"
gem_dist="$(ls -d "$src"/.bundle/ruby/*/gems/discourse-emojis-"$gem_version"/dist 2>/dev/null | head -1)"
if [ -z "$gem_dist" ]; then
  echo "discourse-emojis $gem_version is not installed in $src/.bundle; run bundle install there" >&2
  exit 1
fi
mkdir -p "$dest/../discourse-emojis/dist/locale_search_aliases"
# The picker's groups and search terms; of the locales' terms, English's,
# the one locale the port speaks.
for f in emojis.json aliases.json tonable_emojis.json translations.json groups.json \
  search_aliases.json locale_search_aliases/en.json; do
  cp "$gem_dist/$f" "$dest/../discourse-emojis/dist/$f"
done
echo "discourse_emojis=$gem_version" >> "$dest/DISCOURSE_REF"
# The `?v=` on emoji image URLs (frontend/pretty-text/addon/emoji/version.js).
image_version="$(git -C "$src" show "$commit:frontend/pretty-text/addon/emoji/version.js" \
  | sed -n 's/^export const IMAGE_VERSION = "\(.*\)";$/\1/p')"
echo "emoji_image_version=$image_version" >> "$dest/DISCOURSE_REF"
echo "vendored discourse-emojis $gem_version"
