#!/usr/bin/env bash
# Vendor the Discourse files discourse-rs is built against.
#
# Files are copied as committed at REF (default HEAD) into vendor/discourse/
# under their Discourse paths, so local uncommitted changes in the checkout
# (e.g. plugin migrations in structure.sql) never leak in. The revision is
# recorded in vendor/discourse/DISCOURSE_REF.
#
# Also regenerates seed/010_uploads.sql, which depends on the seeded image
# files at that revision.
#
# Usage: scripts/vendor-discourse <path-to-discourse> [ref]
set -euo pipefail

FILES=(
  db/structure.sql
  config/site_settings.yml
  app/assets/stylesheets/common/foundation/colors.scss
)

if [ $# -lt 1 ]; then
  echo "usage: $0 <path-to-discourse> [ref]" >&2
  exit 64
fi

src="$1"
ref="${2:-HEAD}"
root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/vendor/discourse"

commit="$(git -C "$src" rev-parse --verify "$ref^{commit}")"
committed_at="$(git -C "$src" show -s --format=%cI "$commit")"

for f in "${FILES[@]}"; do
  mkdir -p "$dest/$(dirname "$f")"
  git -C "$src" show "$commit:$f" > "$dest/$f"
done

cat > "$dest/DISCOURSE_REF" <<EOF
commit=$commit
committed_at=$committed_at
EOF

# db/fixtures/010_uploads.rb: seeded uploads -1..-6 pointing at bundled
# images. sha1 is "_" + sha1(file), truncated to Upload::SHA1_LENGTH (40).
{
  echo "-- Generated by scripts/vendor-discourse from db/fixtures/010_uploads.rb"
  echo "-- at Discourse $commit. Do not edit."
  echo "INSERT INTO uploads (id, user_id, original_filename, url, filesize, extension, sha1, created_at, updated_at) VALUES"
  sep=""
  for pair in -1:d-logo-sketch.png -2:d-logo-sketch-small.png -3:default-favicon.ico \
              -4:default-apple-touch-icon.png -5:discourse-logo-sketch.png \
              -6:discourse-logo-sketch-small.png; do
    id="${pair%%:*}"
    file="${pair#*:}"
    size="$(git -C "$src" cat-file -s "$commit:public/images/$file")"
    sha1="$(git -C "$src" show "$commit:public/images/$file" | sha1sum | cut -c1-39)"
    printf "%s  (%s, -1, '%s', '/images/%s', %s, '%s', '_%s', now(), now())" \
      "$sep" "$id" "$file" "$file" "$size" "${file##*.}" "$sha1"
    sep=$',\n'
  done
  echo ";"
} > "$root/seed/010_uploads.sql"

versions="$(grep -cE "^\('[0-9]+'\)[,;]$" "$dest/db/structure.sql")"
echo "vendored ${#FILES[@]} files from $commit ($committed_at), $versions schema versions"
