#!/usr/bin/env bash
# Vendor the Discourse files discourse-rs is built against.
#
# Files are copied as committed at REF (default HEAD) into vendor/discourse/
# under their Discourse paths, so local uncommitted changes in the checkout
# (e.g. plugin migrations in structure.sql) never leak in. The revision is
# recorded in vendor/discourse/DISCOURSE_REF.
#
# Usage: scripts/vendor-discourse <path-to-discourse> [ref]
set -euo pipefail

FILES=(
  db/structure.sql
  config/site_settings.yml
  app/assets/stylesheets/common/foundation/colors.scss
  config/locales/server.en.yml
  config/locales/client.en.yml
  lib/common_passwords/10-char-common-passwords.txt
  vendor/assets/svg-icons/discourse-additional.svg
  vendor/assets/svg-icons/fontawesome/solid.svg
  vendor/assets/svg-icons/fontawesome/regular.svg
  vendor/assets/svg-icons/fontawesome/brands.svg
)

if [ $# -lt 1 ]; then
  echo "usage: $0 <path-to-discourse> [ref]" >&2
  exit 64
fi

src="$1"
ref="${2:-HEAD}"
root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/vendor/discourse"

commit="$(git -C "$src" rev-parse --verify "$ref^{commit}")"
committed_at="$(git -C "$src" show -s --format=%cI "$commit")"

for f in "${FILES[@]}"; do
  mkdir -p "$dest/$(dirname "$f")"
  git -C "$src" show "$commit:$f" > "$dest/$f"
done

# The bundled plugins' settings, one YAML document per plugin in the order
# Rails loads them (by directory name): the plugin, the setting its
# plugin.rb names with `enabled_site_setting`, and its config/settings.yml
# verbatim under `settings`.
plugin_settings="$dest/config/plugin_settings.yml"
: > "$plugin_settings"
plugins=0
while read -r f; do
  name="$(echo "$f" | cut -d/ -f2)"
  enabled="$(git -C "$src" show "$commit:plugins/$name/plugin.rb" 2>/dev/null \
    | sed -n 's/^ *enabled_site_setting :\([a-z0-9_]*\).*/\1/p' | head -1)"
  {
    echo "---"
    echo "plugin: $name"
    echo "enabled_site_setting: ${enabled:-~}"
    echo "settings:"
    # The echo ends a file that has no trailing newline.
    { git -C "$src" show "$commit:$f"; echo; } | sed -e '/^---[[:space:]]*$/d' -e 's/^/  /'
  } >> "$plugin_settings"
  plugins=$((plugins + 1))
done < <(git -C "$src" ls-tree -r --name-only "$commit" plugins \
  | grep -E '^plugins/[^/]+/config/settings.yml$' | LC_ALL=C sort)
echo "vendored the settings of $plugins plugins"

# The bundled plugins' client translations (`js.poll.*` and the like, which
# cooking reads), one YAML document per plugin in the same order.
plugin_client="$dest/config/locales/plugin_client.en.yml"
: > "$plugin_client"
while read -r f; do
  {
    echo "--- # $f"
    { git -C "$src" show "$commit:$f"; echo; } | sed -e '/^---[[:space:]]*$/d'
  } >> "$plugin_client"
done < <(git -C "$src" ls-tree -r --name-only "$commit" plugins \
  | grep -E '^plugins/[^/]+/config/locales/client\.en\.yml$' | LC_ALL=C sort)
echo "vendored $(grep -c '^--- # ' "$plugin_client") plugin client locales"

cat > "$dest/DISCOURSE_REF" <<EOF
commit=$commit
committed_at=$committed_at
EOF

versions="$(grep -cE "^\('[0-9]+'\)[,;]$" "$dest/db/structure.sql")"
# The markers Email::Receiver cuts replies at (`user_notifications.
# previous_discussion` and `reply_above_line`), in every server locale:
# its regexes join the translations of all available locales. One
# `key<TAB>value` line each, the value as the YAML double-quoted it.
markers="$dest/config/email_markers.tsv"
: > "$markers"
while read -r f; do
  git -C "$src" show "$commit:$f" \
    | sed -n -E 's/^    (previous_discussion|reply_above_line): "(.*)"$/\1\t\2/p' >> "$markers"
done < <(git -C "$src" ls-tree -r --name-only "$commit" config/locales \
  | grep -E '^config/locales/server\.[^./]+\.yml$' | LC_ALL=C sort)
echo "vendored $(wc -l < "$markers") email reply markers"

echo "vendored ${#FILES[@]} files from $commit ($committed_at), $versions schema versions"

# Emoji names/codes come from the discourse-emojis gem at the version in
# Gemfile.lock, read from the checkout's bundle (not committed to Discourse).
gem_version="$(git -C "$src" show "$commit:Gemfile.lock" | sed -n 's/^    discourse-emojis (\(.*\))$/\1/p' | head -1)"
gem_dist="$(ls -d "$src"/.bundle/ruby/*/gems/discourse-emojis-"$gem_version"/dist 2>/dev/null | head -1)"
if [ -z "$gem_dist" ]; then
  echo "discourse-emojis $gem_version is not installed in $src/.bundle; run bundle install there" >&2
  exit 1
fi
mkdir -p "$dest/../discourse-emojis/dist"
for f in emojis.json aliases.json tonable_emojis.json translations.json; do
  cp "$gem_dist/$f" "$dest/../discourse-emojis/dist/$f"
done
echo "discourse_emojis=$gem_version" >> "$dest/DISCOURSE_REF"
# The `?v=` on emoji image URLs (frontend/pretty-text/addon/emoji/version.js).
image_version="$(git -C "$src" show "$commit:frontend/pretty-text/addon/emoji/version.js" \
  | sed -n 's/^export const IMAGE_VERSION = "\(.*\)";$/\1/p')"
echo "emoji_image_version=$image_version" >> "$dest/DISCOURSE_REF"
echo "vendored discourse-emojis $gem_version"
