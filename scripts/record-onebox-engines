#!/usr/bin/env bash
# Record which onebox engine Discourse picks for the URLs of its onebox
# specs and parity/onebox_engines/extra.json, and what the engines that
# need no fetch render, from the reference agent, into
# parity/onebox_engines/expected.json (scripts/onebox_engines_export.rb,
# read-only). tests/onebox_engines.rs runs the same inputs.
#
# Usage: scripts/record-onebox-engines <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi

agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
dir="$root/parity/onebox_engines"

dv copy "$root/scripts/onebox_engines_export.rb" "$agent:/tmp/onebox_engines_export.rb" > /dev/null
dv copy "$dir/extra.json" "$agent:/tmp/onebox_engines_extra.json" > /dev/null
dv run --name "$agent" -- bin/rails runner /tmp/onebox_engines_export.rb \
  /tmp/onebox_engines_extra.json /tmp/onebox_engines_expected.json | tail -1
dv copy "$agent:/tmp/onebox_engines_expected.json" "$dir/expected.json" > /dev/null
echo "wrote $dir/expected.json"
