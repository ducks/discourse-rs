#!/usr/bin/env bash
# Record what Discourse does for the write requests in parity/writes/cases.json
# into parity/writes/<case>.json, on the reference agent, without changing it
# (scripts/record_writes.rb). tests/writes.rs replays them on the seed.
#
# Usage: scripts/record-writes <agent-name>
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <agent-name>" >&2
  exit 64
fi

agent="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/parity/writes"

dv copy "$root/scripts/record_writes.rb" "$agent:/tmp/record_writes.rb" > /dev/null
dv copy "$dest/cases.json" "$agent:/tmp/write_cases.json" > /dev/null
# The files cases upload (parity/writes/files).
dv run --name "$agent" -- rm -rf /tmp/write-files
dv run --name "$agent" -- mkdir -p /tmp/write-files
for f in "$dest"/files/*; do
  [ -f "$f" ] && dv copy "$f" "$agent:/tmp/write-files/$(basename "$f")" > /dev/null
done
dv run --name "$agent" -- rm -rf /tmp/write-record
dv run --name "$agent" -- bin/rails runner /tmp/record_writes.rb /tmp/write_cases.json /tmp/write-record /tmp/write-files
for f in $(jq -r '.[].name' "$dest/cases.json"); do
  dv copy "$agent:/tmp/write-record/$f.json" "$dest/$f.json" > /dev/null
done
echo "wrote $dest"
